# ==============================================================================
# DealFlow360 — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
*.env
# Allow committed environment templates
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# Python & Backend
# ------------------------------------------------------------------------------
# Bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Packaging and distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, coverage, and linting
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
nosetests.xml
*.cover
*.py,cover
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node & Frontend (React / Vite)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/

# Bundler & tool caches
.vite/
.turbo/
.parcel-cache/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Database & Local Runtime Artifacts
# ------------------------------------------------------------------------------
# Local embedded / scratch databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Local Docker / PostgreSQL volume mount directories
pgdata/
postgres_data/

# Runtime logs and temporary files
*.log
logs/
tmp/
temp/

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Editor backup / swap files
*.swp
*.swo
*~
.#*

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
