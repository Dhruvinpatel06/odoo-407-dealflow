# DealFlow360 Backend Environment Variables
ENVIRONMENT=development
DEBUG=True
APP_NAME=DealFlow360-Backend
API_V1_STR=/api/v1
PORT=8000

# PostgreSQL Database (Direct / Self-Managed)
DATABASE_URL=postgresql://dealflow_user:dealflow_password@localhost:5432/dealflow360

# Supabase Auth Configuration (Auth Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
